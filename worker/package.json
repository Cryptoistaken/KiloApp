{
  "name": "sheetsubmit-backend",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "schema:bootstrap": "bun scripts/schema.ts bootstrap",
    "schema:verify": "bun scripts/schema.ts verify",
    "edge:dry": "wrangler deploy --dry-run",
    "edge:deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.11.0",
    "@neondatabase/serverless": "^1.0.0",
    "postgres": "^3.4.9",
    "redis": "~6.2.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "bun-types": "^1.4.0",
    "typescript": "~6.0.2",
    "wrangler": "^4.0.0"
  }
}
