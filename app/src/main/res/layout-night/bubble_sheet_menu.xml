<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_sheet_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/bubble_sheet_panel"
        android:layout_width="230dp"
        android:layout_height="280dp"
        android:orientation="vertical"
        android:background="@drawable/menu_panel_bg"
        android:clipToOutline="true"
        android:layout_gravity="top|start"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp">

        <!-- Same 44dp bar as the proxy/SMS popups. No close button: a tap
             outside the panel dismisses, like the read-only sheet window. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/bubble_sheet_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Sheet type"
                android:scaleType="centerInside" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/bubble_sheet_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#F4F4F5"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bubble_sheet_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#A1A1AA"
                    android:textSize="9sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/bubble_tool_undo"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="2dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Undo"
                android:padding="5dp"
                android:src="@drawable/ic_ss_undo" />

            <ImageButton
                android:id="@+id/bubble_tool_redo"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Redo"
                android:padding="5dp"
                android:src="@drawable/ic_ss_redo" />

            <!-- In-app Check split button parity: one joined 6dp pill (bg set
                 in code to primary / 38% when disabled), Check action left,
                 options arrow right, spinner while checking. -->
            <LinearLayout
                android:id="@+id/bubble_tool_check_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ProgressBar
                    android:id="@+id/bubble_tool_spinner"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="10dp"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/bubble_tool_check"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="Check"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/bubble_tool_arrow"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Check options"
                    android:padding="8dp"
                    android:src="@drawable/ic_ss_check_arrow" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bubble_check_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:elevation="8dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#3F3F46" />

        <!-- The shared SheetGrid component (same file view as the app,
             hosted read-only in a ComposeView) + the empty state. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="2dp">

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/bubble_sheet_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/bubble_sheet_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="16dp"
                android:text="No rows yet"
                android:textColor="#A1A1AA"
                android:textSize="11sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
