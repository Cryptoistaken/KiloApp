# Gradle build cache
.gradle/
build/

# Local Android hot-reload CLI/runtime files
/hotreload
/.hotreload/

# Android Studio / IDE
.idea/
*.iml

# Local machine config (SDK paths etc.)
local.properties

# Native build output (copied into jniLibs during build)
obj/
libs/
/assets/
app/src/main/jniLibs/

# Built APKs & artifacts
*.apk
apk-out*/
apk-out-fixed/
artifacts/

# Debug dumps, screenshots, mockups
screenshots/
uixml
theme_dropdown.png
screenshot.png
redesign-mockup.html

# Logs
*.log
*.hprof

# Secrets — release keystore backup (never commit)
.keystore-backup/
*.jks
*.b64

# JS deps (worker/ + Pages/ use bun; never commit installs)
node_modules/

# Misc
.foglamp/
superproxy_screen*.xml

# Tooling / demo files
.playwright-mcp/
floating-bubble-demo.html

# Downloaded Android docs cache (offline reference)
.androiddocs/
